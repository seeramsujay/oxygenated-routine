# Google Gemini API key (get a free-tier key from https://aistudio.google.com/apikey)
# Without this key, the app runs 100% on the built-in offline rule engine.
GEMINI_API_KEY=

# Optional: override the default Gemini model (defaults to gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: set to 1 to force the offline rule engine even when GEMINI_API_KEY is set
# DISABLE_LLM=0
