{
  "name": "oxygenated-routine",
  "version": "1.0.0",
  "description": "GenAI assistant that helps families navigate winter smog with low-emission routines, indoor air hacks and quantified impact.",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && stylelint \"public/**/*.css\" && htmlhint public/index.html && prettier --check . && cspell --no-progress \"**/*.{js,html,css,json,md,yml}\"",
    "format": "prettier --write ."
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
